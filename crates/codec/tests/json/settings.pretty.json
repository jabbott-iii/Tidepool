{
  "theme": "tidepool-dark",
  "font": {
    "family": "Tidepool Mono",
    "size": 13.5,
    "ligatures": false
  },
  "editor": {
    "rulers": [
      80,
      100
    ],
    "tab_width": 4,
    "scroll_speed": 0.25,
    "keymap": "vim",
    "format_on_save": true
  },
  "languages": {
    "rust": {
      "server": "rust-analyzer",
      "args": [],
      "env": null
    },
    "markdown": {
      "preview": {
        "sync_scroll": true,
        "zoom": -1.0
      }
    }
  },
  "note": "50% → \"ok\"\t(tab), url: http://example.com/a//b /* not a comment */"
}
